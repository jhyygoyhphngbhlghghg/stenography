# Copy to config/.env if needed. Do not commit secrets.

# Offline stenography (no network at inference)
SAMPLE_RATE=16000
MAX_ASR_CHUNK_SEC=30

# PresentConnect — presentation backend (network mode only)
PRESENT_CONNECT_WS_URL=wss://present.example.local/v1/present-connect
PRESENT_CONNECT_HTTP_URL=https://present.example.local
PRESENT_CONNECT_MAX_STREAMS=20

# Model cache on device / after scripts/download-models.sh
MODELS_DIR=models
ASR_ENGINE=zipformer-ru-int8
