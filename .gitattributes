# The repo stores LF; scripts must stay LF or a Linux/macOS clone gets
# "bad interpreter" on the shebang line.
* text=auto

*.sh          text eol=lf
gradlew       text eol=lf
*.py          text eol=lf
*.kt          text eol=lf
*.kts         text eol=lf
*.json        text eol=lf
*.csv         text eol=lf
*.md          text eol=lf
*.xml         text eol=lf
*.pro         text eol=lf
*.properties  text eol=lf
*.env         text eol=lf

# Never let Git try to normalize binary artifacts
*.wav         binary
*.onnx        binary
*.gguf        binary
*.aar         binary
*.jar         binary
*.apk         binary
*.png         binary
*.jpg         binary
*.mp4         binary
*.bz2         binary
*.gz          binary
*.zip         binary
