{
  "name": "neurosteno-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:deck": "npm --prefix ../present ci && npm --prefix ../present run build",
    "build:all": "npm run build && npm run build:deck",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "sim:phone": "tsx src/simulate-phone.ts"
  }
}
